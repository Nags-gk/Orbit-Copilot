# ── Databases ──────────────────────────────────────────────
# Orbit's database (Orbit owns the schema; the copilot never migrates it).
# Default assumes orbit/ and orbit-copilot/ are checked out side by side.
ORBIT_DATABASE_URL=sqlite+aiosqlite:///../orbit/backend/orbit.db
# The copilot's own conversations and messages.
COPILOT_DATABASE_URL=sqlite+aiosqlite:///./copilot.db

# ── Identity ───────────────────────────────────────────────
# Must match the key Orbit signs JWTs with (backend/app/services/security.py).
ORBIT_JWT_SECRET=orbit_super_secret_local_key
# Single-user local mode: no valid token → act as the oldest Orbit user.
# Set to false for any shared or multi-user deployment.
ALLOW_LOCAL_USER=true

# ── AI provider (priority: local > Gemini > demo > Anthropic) ──
USE_LOCAL_LLM=false
LOCAL_MODEL_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=llama3.1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── HTTP ───────────────────────────────────────────────────
# Comma-separated origins, or * for local-network/phone access.
CORS_ORIGINS=*
